MAX_IBJA_GAP=0.10

# --- AI assist (reads enquiries, drafts WhatsApp replies). Server-only; never exposed to the browser. ---
# Get a key at console.anthropic.com → API Keys. Without it, the app uses the rule-based reader and a standard message.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-haiku-5-5), or AI_ASSIST=off to switch AI off without removing the key.
# ANTHROPIC_MODEL=
# AI_ASSIST=off
# Storage: on Vercel, data goes to the private Blob store (BLOB_READ_WRITE_TOKEN is set by Vercel).
# Locally it goes to data/db.local.json. Pull the token with `npx vercel env pull .env.local`,
# then set QUOTE_STORE=blob to use Blob from your machine.
# BLOB_READ_WRITE_TOKEN=
# QUOTE_STORE=blob
