MAX_IBJA_GAP=0.10
# Storage: on Vercel, data goes to the private Blob store (BLOB_READ_WRITE_TOKEN is set by Vercel).
# Locally it goes to data/db.local.json. Pull the token with `npx vercel env pull .env.local`,
# then set QUOTE_STORE=blob to use Blob from your machine.
# BLOB_READ_WRITE_TOKEN=
# QUOTE_STORE=blob
