GST_RATE=0.03
MAX_IBJA_GAP=0.10
# Quotes: on Vercel they go to the private Blob store (BLOB_READ_WRITE_TOKEN is set by Vercel).
# Locally they go to data/quotes.local.json. Get a token with `vercel env pull`, then
# set QUOTE_STORE=blob to use Blob locally.
# BLOB_READ_WRITE_TOKEN=
# QUOTE_STORE=blob
# QUOTE_STORE_PATH=
